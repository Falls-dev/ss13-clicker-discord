# Public Discord application ID (same value as VUE_APP_DISCORD_CLIENT_ID)
DISCORD_CLIENT_ID=
VUE_APP_DISCORD_CLIENT_ID=

# Private OAuth secret from Discord Developer Portal → OAuth2
DISCORD_CLIENT_SECRET=

# Activity HTTP(S) server. nginx proxies https://spacestation13clicker.ss13.site → localhost:4443
PORT=4443
HOST=0.0.0.0
BEHIND_PROXY=1

# 1 = debug overlay + /api/debug/session
DEBUG=0

# Optional. Not needed when nginx terminates TLS.
TLS_CERT=
TLS_KEY=
